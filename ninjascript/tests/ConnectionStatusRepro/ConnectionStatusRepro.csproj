<Project Sdk="Microsoft.NET.Sdk">

  <!-- DS-104 scaffold. Assembly paths MUST be validated on the Windows host
       (Cbi/Core/Gui live under C:\Program Files\NinjaTrader 8\bin\ on a real
       install; Custom under Documents\NinjaTrader 8\bin\Custom). Not built on WSL. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>ConnectionStatusRepro</AssemblyName>
    <RootNamespace>DS104</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ACTUAL production sources (dev tip), compiled in so the type under
         test is the real VLTraderTCPClient, not a copy. -->
    <Compile Include="../../VLTraderTCPClient.cs" />
    <Compile Include="../../VLBarsSubscriptionManager.cs" />
    <Compile Include="../../VLContractResolver.cs" />
    <Compile Include="../../VLInstrumentLookup.cs" />
    <Compile Include="../../VLHistoryPull.cs" />
    <Compile Include="ReproProgram.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- NinjaTrader 8 framework assemblies — validate paths per machine. -->
    <Reference Include="NinjaTrader.Core">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Core.dll</HintPath>
    </Reference>
    <Reference Include="NinjaTrader.Gui">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Gui.dll</HintPath>
    </Reference>
    <Reference Include="NinjaTrader.Client">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Client.dll</HintPath>
    </Reference>
    <Reference Include="NinjaTrader.Vendor">
      <HintPath>C:\Program Files\NinjaTrader 8\bin\NinjaTrader.Vendor.dll</HintPath>
    </Reference>
    <Reference Include="NinjaTrader.Custom">
      <HintPath>$(USERPROFILE)\Documents\NinjaTrader 8\bin\Custom\NinjaTrader.Custom.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
