# VL Environment Variables Template
# Copy this file to .env and modify the values as needed

# ===========================================
# Server Configuration
# ===========================================

# Backend API server port
VL_BACKEND_PORT=8080

# Interface the API binds to. DEFAULT (unset) = 127.0.0.1, loopback only.
# The API carries broker/model credentials and full trader control, so it should
# not be reachable off-host. Set this to 0.0.0.0 ONLY behind a firewall or a
# reverse proxy that terminates TLS and authenticates — a non-loopback value
# logs a warning at boot.
# API_SERVER_HOST=127.0.0.1

# Frontend web interface port
VL_FRONTEND_PORT=3000

# Timezone

# DESTRUCTIVE escape hatch: POST /api/reset-account deletes EVERY user, trader
# and strategy. It requires a valid JWT, this flag, and a
# {"confirm":"RESET-ALL-DATA"} body. Leave unset (disabled) in normal operation.
# ALLOW_ACCOUNT_RESET=1

# ===========================================
# Authentication (Required)
# ===========================================

# JWT signing secret (any random string, at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-change-this-in-production

# ===========================================
# Encryption Keys (Required)
# ===========================================

# AES-256 data encryption key (Base64 encoded, 32 bytes)
# Used for encrypting sensitive data in database (API keys, secrets)
# Generate with: openssl rand -base64 32
DATA_ENCRYPTION_KEY=your-base64-encoded-32-byte-key

# RSA private key for client-server encryption (PEM format)
# Used for end-to-end encryption of sensitive data from browser
# Generate with: openssl genrsa 2048
# Note: Replace newlines with \n for single-line format
RSA_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----

# ===========================================
# Security Options
# ===========================================

# Transport encryption for API keys (default: false)
# When enabled, browser uses Web Crypto API to encrypt API keys before sending
# Requires HTTPS or localhost to work
# Set to true for enhanced security (HTTPS required)
# Set to false for easier deployment (HTTP/IP access allowed)
TRANSPORT_ENCRYPTION=false

# ===========================================
# Optional: External Services
# ===========================================

DB_TYPE=postgres
DB_HOST=10.
DB_PORT=5432
DB_USER=vl_user
DB_PASSWORD=
DB_NAME=vl
DB_SSLMODE=disable


# Database configuration - SQLite (default)
DB_TYPE=sqlite
DB_PATH=data/data.db

# ===========================================
# NQ futures (Databento + NinjaTrader)
# ===========================================

# Trading mode: "crypto" (default) or "futures" to enable NQ path
# C2 — futures-only build: TRADING_MODE is accepted only as "futures" (or unset);
# any other value is ignored with one boot warning. The line is intentionally
# ABSENT — no crypto mode exists any more.

# Databento Historical API key — https://databento.com/portal/keys
# Auth model: HTTP Basic, key as username, empty password
DATABENTO_API_KEY=

# Databento dataset code (GLBX.MDP3 covers all CME Globex products)
DATABENTO_DATASET=GLBX.MDP3

# NinjaTrader transport: "tcp" = the real-time TCP bridge (REQUIRED for live
# bars + execution; the CSV path is deprecated). Must live HERE in .env —
# systemd services and cron never read ~/.bashrc, so a value set only there
# silently falls back to CSV.
NT_TRANSPORT=tcp

# NinjaTrader CSV bridge data directory (WSL2 view of Windows path)
# Legacy/deprecated path — only used when NT_TRANSPORT is not "tcp"
# e.g. /mnt/c/Users/<you>/<NT8 data dir>
NINJATRADER_DATA_DIR=
# ── AI call timeout (incident 2026-08-18: hardcoded 180s decision cap killed
# DeepSeek reads mid-body once max_tokens was raised and reasoning responses
# started running 150s+; every timed-out call = a missed decision).
# ONE knob for executor AND planner. Canonical name below; the pre-existing
# AI_TIMEOUT_SECONDS is still honored when this is unset. Default 300.
#AI_HTTP_TIMEOUT_SECONDS=300

# ── DeepSeek thinking mode (docs: https://api-docs.deepseek.com/guides/thinking_mode).
# thinking {type: enabled|disabled} + reasoning_effort low|high|max. Docs: thinking
# is ON by default with effort high; "max" is the true maximum (medium/xhigh map
# to high). Empty value omits the key from the request (provider default).
#DEEPSEEK_THINKING_MODE=enabled
#AI_REASONING_EFFORT=max
# Per-model override (no redeploy): set thinking_mode/reasoning_effort on the
# model row via the UI or the manage_model_config tool. Empty = inherit these env
# defaults; a set value wins for THAT model only.

# ── 4.3 limit-then-market EOD/T1 flatten (research v5 "slippage budgeted") ──
# DORMANT: 0/0 = pure market flatten (historical behavior).
# EOD_FLAT_LIMIT_TICKS > 0 = place a limit exit that many ticks beyond the
# latest 1m bar close first, then market-flatten any remainder after
# EOD_FLAT_MARKET_AFTER_SEC seconds. Needs the rebuilt NT8 AddOn (F5 + restart).
#EOD_FLAT_LIMIT_TICKS=0
#EOD_FLAT_MARKET_AFTER_SEC=10

# ── Session-scoped last-entry / EOD-flat (P2 redesign 2026-08-18). Both are
# offsets in MINUTES BEFORE each session's end, per-session under
# day_plan.sessions[]: {"session":"ASIA","last_entry_offset_min":15,
# "eod_flat_offset_min":15}. Default 15. The old day-scoped 13:00 CT cutoff
# (blocked Asia evenings entirely) and the 14:45 CT flat literal are
# unreachable; see trader/auto_trader_clock.go sessionCutoffCT.

# ── Stale-bar grace (stale-bar dispatch 2026-08-19). A timeframe is stale only
# when the bar that SHOULD exist for the current period is missing:
# newest_open < floor(now/period)*period − period − grace. This is the delivery
# slack in SECONDS. Default 15. (The old 2×interval math was calibrated on
# END-stamped bars and lost one period of slack when stamps were corrected.)
#STALE_BAR_GRACE_S=15

# ── Flip-eval freshness (regime wave G7, 2026-08-21). The plan flip/death
# evaluator SKIPS any evaluation whose rule-timeframe series is provably stale:
# newest closed rule-TF bar older than (period + this many SECONDS). Skipped
# evaluations log flip_eval_skipped and defer to the next fresh cycle — a state
# transition is never guessed on stale bars. The executor prompt gets the same
# staleness warning under the affected TF table. Default 90.
#FLIP_EVAL_MAX_STALE_S=90

# ── Structure detectors (regime wave G2, 2026-08-21). Fractal swing engine per
# TF (5m/15m/1h) → HH/HL/LH/LL → TRENDING_UP/DOWN/RANGING + BOS/CHoCH/SWEEP
# events; MSS = CHoCH + displacement. Advisory only — G1/G4/G8 consume it.
#STRUCTURE_SWING_K=2            # fractal window: bar must exceed k bars each side
#STRUCTURE_MIN_SWING_ATR=0.25   # swing move must be ≥ this × ATR vs prior opposite swing
#STRUCTURE_MSS_BODY_ATR=1.5     # MSS displacement: CHoCH bar body ≥ this × ATR

# ── HTF veto (regime wave G1, 2026-08-21). New entries opposing the CONFIRMED
# higher-TF structure trend are refused ("htf_veto: short vs 1h TRENDING_UP …").
# RANGING/unconfirmed fail open. Studio toggle htf_veto (default ON) is the
# off-switch; this env picks the veto timeframe (default 1h).
#HTF_VETO_TF=1h

# ── Transition stand-down (regime wave G4, 2026-08-21). An unconfirmed
# counter-trend CHoCH/MSS on the plan's bias TF opens TRANSITION: new entries
# in the plan's direction pause until flip/re-plan, BOS resumption, or this cap
# expires. Studio toggle transition_standdown (default ON) is the off-switch.
#TRANSITION_MAX_MIN=45

# ── Flip hysteresis (regime wave G3, 2026-08-21). A freshly-written plan cannot
# flip back within this many MINUTES of its birth unless the death line is
# breached (death always wins — evaluated first). Anti double-flip chop.
#FLIP_MIN_HOLD_MIN=30

# ── In-position feed alert (in-position silence fix 2026-08-19). While a
# position is OPEN, the NT8 feed-down alert threshold tightens from the normal
# 10 minutes to this many SECONDS (missing data gets LOUDER in-position, never
# quieter). Default 120. The alert renders as the persistent dashboard banner
# "⚠ NO DATA WHILE POSITION OPEN — check NT8" (in-app only).
#INTRADE_FEED_ALERT_S=120

# ── Skip-gate position reconciliation (P0 hotfix 2026-08-19). Before
# skip-while-open trusts a store row, it cross-checks the broker's LIVE
# position state; store-open vs broker-flat logs CRITICAL
# position_state_desync and the cycle proceeds (no skip). Row-closing stays
# with close-sync/reconcile (real exit price). Default on; "off" disables.
#POSITION_RECONCILE=on

# ── Clock early-warning (ledger-close P1, 2026-08-19). The clock-health line
# (boot + session roll) logs "🚨 CLOCK EARLY-WARNING" when |Go-vs-feed drift|
# reaches this many MILLISECONDS — half of C2's 60s tolerance by default, so
# the operator hears about drift BEFORE staleness verdicts degrade. Log-only.
# The 15-min clock-guard user timer (deploy/install-clock-guard.sh) uses the
# seconds analog CLOCK_GUARD_WARN_S (default 30) and VL_CLOCK_STATE for its
# state file (default data/clock-guard-state.json).
#CLOCK_WARN_MS=30000

# ── Contract-roll entry block (ledger-close P3, 2026-08-19). Within this many
# CALENDAR days of the ACK-resolved front contract's third-Friday expiry
# (CT dates, inclusive; SEP26 = 2026-09-18 per CME ProductCalendar), NEW
# entries are refused; closes/position management continue. Fail-open when the
# contract is unresolved. Default 3 → Sep 15-18 blocked for SEP26.
#ROLL_BLOCK_DAYS_BEFORE_EXPIRY=3

# ── Half-days file (ledger-close P4, 2026-08-19). Owner-editable JSON array of
# {date:"YYYY-MM-DD", early_close_ct:"HH:MM", label:"..."} seeded into the
# session registry once per session-day; EOD-flat and last-entry cutoffs then
# resolve against early_close_CT − offset for the truncated session(s).
# Official 2026 CME sources cited in trader/auto_trader_halfdays.go.
# Malformed/missing → CRITICAL log + normal trading (fail-open).

# ── AI balance warning (ledger-close P5, 2026-08-19). When set (USD), the bot
# polls DeepSeek's GET /user/balance once per session-day and raises a WARN +
# P1 alert below this threshold — BEFORE the account hits 402 and decisions
# stop. Unset/invalid = OFF (no network call). The 402 outage itself always
# raises one P0 "AI CREDIT EXHAUSTED" banner per outage, auto-cleared by the
# first successful call; decision_records carries error_class=ai_payment_402.
#AI_BALANCE_WARN=5.00

# ── Log-shipping retention (ledger-close P6, 2026-08-19). WARN/ERROR/CRITICAL
# log lines are teed to the DB table log_events (async, drop-on-overload,
# never blocks trading) because journald's 2G cap rotates in hours under
# per-frame INFO logging — the Aug 13-17 forensic window was already gone.
# Rows older than this many days are hard-deleted once per day.
#LOG_DB_RETENTION_DAYS=30

# ── Discard-burn (final-bundle Phase 2, 2026-08-19). Baseline: 18.5% of paid
# AI calls died as supersession discards at 5m closes (#51 E17).
# STALE_DODGE: defer a cycle that would start within (avg_call_ms×1.2) of the
# decision-TF's next close to close+1s, so the call runs inside one bar.
# Default ON; only an explicit off/0/false disables. Avg = last 20 calls.
#STALE_DODGE=on
# Superseded ENTRY re-eval drift bound: the entry executes only if the fresh
# closed bar never touched its stop AND |price drift since snapshot| is below
# this multiple of ATR(14,5m). Default 0.25.
#STALE_REEVAL_DRIFT_ATR=0.25

# ── In-position watcher (final-bundle Phase 3, 2026-08-19). position_mode is a
# PER-TRADER DB setting (Trader edit → "In-position AI mode"): ai_watch
# (default — watch-only cycles while holding, zero order authority) or
# bracket_only (legacy silent skip). These env knobs tune the hysteresis rails
# (owner's Jan-2026 signal-stability research: 2:1 hysteresis, consecutive
# confirmation):
# R1 — "invalidated" accepted only when the response cites the stated condition
#      AND confidence ≥ this; else recorded as weakening.
#WATCH_INVALIDATE_MIN_CONF=70
# R2 — status may not downgrade again within this many watch cycles of the last
#      change (upgrades/recovery are always free).
#WATCH_MIN_HOLD_CYCLES=2
# R3 — the ⚠ THESIS INVALIDATED dashboard WARN fires only after this many
#      CONSECUTIVE accepted invalidated reads; one WARN per position episode.
#WATCH_WARN_CONSECUTIVE=2

# ── Trailing profit (final-bundle Phase 3B, 2026-08-19). STUDIO-configured
# (Risk Control → trailing_*), NOT env: enabled toggle (default OFF), ATR
# multiple (2.0), ATR period (14, 5m), arm mode (after_breakeven default |
# after_trigger_points | immediate) + arm points. Documented here for the
# config census only — the fields persist in strategies.config
# ai_config.risk_control (the correct nest; top-level risk_control is the
# documented audit trap).

# ── Post-exit immediate rescan (final-bundle Phase 4, 2026-08-19). On a
# confirmed position close (TP/SL/EOD-flat/manual/reconcile) ONE full decision
# cycle fires after the delay — through EVERY gate (session, roll, B7 cooldown,
# stop_until…): immediate ≠ privileged, and the prompt carries no reference to
# the just-closed trade (revenge-bias by context is forbidden). Default ON;
# only an explicit off/0/false disables. Deduped per position id.
#POST_EXIT_RESCAN=on
#POST_EXIT_DELAY_MS=2000

# ── Stop-entry seam (ENTRY-MECHANICS E7, 2026-08-30; kernel/entry_law.go
# StopEntrySeamOn). Stop entries (reclaim / continuation scenarios) are sent to
# NinjaTrader only when this is the literal "on".
# Anything else = off: the arm is written and logged, never placed. Owner ruling
# 2026-09-05 = off (cancels not yet broker-confirmed); precondition shipped
# 2026-09-06 (cancel-confirmation, boot line `🧾 cancels: confirm=broker-snapshot`);
# owner ruling 2026-09-18 07:52 CT = on. Each machine sets it in its OWN .env —
# the boot line `🎯 stop-entry: seam=on …` is the only proof it took.
STOP_ENTRY_SEAM=on

# ── Unified feed-aliveness policy (fail-register wave B2, 2026-08-20). ONE
# policy object feeds BOTH the B4 entry-gate fallback (any subscribed TF — a
# {15m,1h}-only selection is no longer blind) and the feed-down alerts.
# Flat-state threshold (seconds); was the hardcoded 10-minute const.
#FEED_ALERT_S=600
# In-position threshold (existing env, unchanged default).
#INTRADE_FEED_ALERT_S=120

# ── Structured confirmation grace (fail-register wave C1, 2026-08-20). Every
# plan scenario must author confirm{rule, ref_price, side}; for the first N
# distinct plan sessions after deploy the validator ACCEPTS missing confirm{}
# with a WARN (the planner model may lag the new contract), then it becomes
# required. Compliance fast-forwards the window.
#CONFIRM_GRACE_SESSIONS=3
