<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0169;CS0414;CS0649</NoWarn>
    <!-- -p:AddonSrc=<dir> points the same tests at another AddOn source (RED proof on the base). -->
    <AddonSrc Condition="'$(AddonSrc)' == ''">../../../../ninjascript</AddonSrc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NT8WireStubs.cs" />
    <Compile Include="Program.cs" />
    <!-- The ACTUAL production AddOn. VLSettleGate.cs is absent on the base source: the
         glob then matches nothing and the same tests run RED against the old client. -->
    <Compile Include="$(AddonSrc)/VLTraderTCPClient.cs" />
    <Compile Include="$(AddonSrc)/ConnectJsonParser.cs" />
    <Compile Include="$(AddonSrc)/VLSettleGate*.cs" />
  </ItemGroup>
</Project>
